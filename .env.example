# Transport: "stdio" for local Claude Code/Desktop, "streamable-http" for hosted
MCP_TRANSPORT=streamable-http

# Port the HTTP server listens on (Railway/Fly set this automatically)
PORT=8000

# Optional: protect the server with a bearer token.
# Set to any secret string. Clients must send: Authorization: Bearer <token>
# Leave empty to disable auth (only do this on a private network).
MCP_AUTH_TOKEN=your-secret-token-here
